    "preview": "vite preview --host 127.0.0.1 --port 5176",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "capture:reference": "node scripts/capture-reference.mjs",
