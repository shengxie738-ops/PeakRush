    "compare:reference": "node scripts/compare-reference.mjs",
    "verify:assets": "node scripts/validate-assets.mjs",
    "verify:evidence": "node scripts/validate-evidence.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "score:clone": "node scripts/score-clone.mjs"
  },
  "dependencies": {
    "lenis": "1.3.3",
    "pinia": "^3.0.3",
    "three": "0.176.0",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "^10.2.0",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
